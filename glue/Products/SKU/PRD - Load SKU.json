{
  "name" : "PRD - Load SKU",
  "jobMode" : "SCRIPT",
  "description" : "Full load, tiny table",
  "role" : "arn:aws:iam::248725110737:role/GlueCustom",
  "executionProperty" : {
    "maxConcurrentRuns" : 1
  },
  "command" : {
    "name" : "glueetl",
    "scriptLocation" : "s3://aws-glue-assets-248725110737-us-west-2/scripts/PRD - Load SKU.py",
    "pythonVersion" : "3"
  },
  "defaultArguments" : {
    "--enable-metrics" : "true",
    "--enable-spark-ui" : "true",
    "--spark-event-logs-path" : "s3://aws-glue-assets-248725110737-us-west-2/sparkHistoryLogs/",
    "--enable-job-insights" : "true",
    "--enable-observability-metrics" : "true",
    "--enable-glue-datacatalog" : "true",
    "--job-bookmark-option" : "job-bookmark-disable",
    "--job-language" : "python",
    "--TempDir" : "s3://aws-glue-assets-248725110737-us-west-2/temporary/"
  },
  "connections" : {
    "connections" : [ "PRD SQL ContentCatalog", "PRD Redshift content_delivery_usage" ]
  },
  "maxRetries" : 0,
  "allocatedCapacity" : 10,
  "timeout" : 480,
  "maxCapacity" : 10.0,
  "glueVersion" : "5.0",
  "numberOfWorkers" : 10,
  "workerType" : "G.1X",
  "executionClass" : "STANDARD",
  "sourceControlDetails" : {
    "provider" : "BITBUCKET",
    "repository" : "learningcom/transformations",
    "branch" : "Products",
    "folder" : "glue/Products/SKU"
  }
}